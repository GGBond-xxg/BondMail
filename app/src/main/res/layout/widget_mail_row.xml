<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/widget_row_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_avatar" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:fontFamily="sans-serif" android:textStyle="normal" android:id="@+id/widget_sender" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
                <TextView android:fontFamily="sans-serif" android:textStyle="normal" android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="9sp" android:maxLines="1" android:includeFontPadding="false"/>
            </LinearLayout>
            <TextView android:fontFamily="sans-serif" android:textStyle="normal" android:id="@+id/widget_subject" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp"/>
            <TextView android:fontFamily="sans-serif" android:textStyle="normal" android:id="@+id/widget_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/widget_divider" android:layout_width="match_parent" android:layout_height="1dp" android:importantForAccessibility="no"/>
</LinearLayout>
